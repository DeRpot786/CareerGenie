# ============================================================
# Career Genie — Environment Variables Example
# Copy this file to .env (or .env.local) and fill in your values.
# NEVER commit your actual .env or .env.local to source control.
# ============================================================

# --- Mistral AI Configuration (Primary AI Engine) ---
# Obtain your Mistral API key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
# Supported models: mistral-small-latest (recommended: fast, cost-effective, JSON native), mistral-large-latest, codestral-latest
AI_PROVIDER=mistral

# --- Google Gemini Multi-Key Configuration (Automatic Rotation & Failover) ---
# Configure up to three Google Gemini API keys for seamless rate-limit failover:
# Obtain Google Gemini API keys: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_first_api_key
GEMINI_API_KEY_2=your_second_api_key
GEMINI_API_KEY_3=your_third_api_key

# Single-key fallback for backward compatibility:
# GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, AI_API_KEY can be used:
AI_API_KEY=your_mistral_or_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_MODEL=mistral-small-latest

# --- Backend Database (Spring Boot / MySQL) ---
DB_ROOT_PASSWORD=root
DB_USERNAME=careergenie
DB_PASSWORD=careergenie123
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/careergenie?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=careergenie
SPRING_DATASOURCE_PASSWORD=careergenie123

# --- JWT Authentication ---
JWT_SECRET=Y2FyZWVyZ2VuaWVzZWNyZXRrZXlmb3Jqd3Rfc2lnbmluZ19wdXJwb3Nlc29ubHk=
JWT_EXPIRY_MS=86400000

# --- CORS & Networking ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

